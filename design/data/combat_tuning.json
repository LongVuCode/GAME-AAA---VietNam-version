  "tuning_changes_0_2": {
    "_note": "FUN_PASS_0_2 §3.7. Đề xuất ĐỔI GIÁ TRỊ cho Demo 0.2, CHƯA áp dụng (giữ bản 0.1 tái lập được). Người triển khai 0.2 áp dụng cùng lúc với mã; mục có pinned_by phải sửa test đó cùng lúc. Giả định, chờ playtest.",
    "changes": [
      {"file": "combat_tuning", "path": "drum_rhythm.gain.light_hit", "from": 8, "to": 12, "reason": "Ước tính một trận cua cho ≈ 1,8 nấc, nên tuyệt kỹ đầu tiên đến sau ≈ 3 trận; đòn đánh chỉ góp phần nhỏ. Đích: lần Hồi trống đầu ở trận thứ 2"},
      {"file": "combat_tuning", "path": "drum_rhythm.gain.parry", "from": 25, "to": 30, "reason": "Thưởng quyết định phòng thủ chủ động hơn đánh bừa"},
      {"file": "combat_tuning", "path": "drum_rhythm.decay_delay_s", "from": 6.0, "to": 12.0, "reason": "Nấc dở không rụng hết trong 10 s đi bộ giữa hai trận"},
      {"file": "combat_tuning", "path": "hit_stop.light_s", "from": 0.04, "to": 0.05, "reason": "Đâm giáo nhẹ quá mỏng; 0,04 s gần bằng 2 khung hình 60 Hz"},
      {"file": "enemies", "path": "boss_lon_loi_dam.hp", "from": 2000, "to": 1600, "reason": "Trận kết bằng cạy theo Thế; HP dài chỉ kéo dài pha đánh bao cát", "pinned_by": "game/Source/ArpgCore/Tests/ConfigTests.cpp (Boar.MaxHealth == 2000)"},
      {"file": "enemies", "path": "boss_lon_loi_dam.phases[1].speed_mult", "from": 0.85, "to": 0.95, "reason": "Pha 2 vẫn 'đau, dễ đọc' nhờ báo hiệu dài, nhưng không được xẹp nhịp ở cao trào"},
      {"file": "enemies", "path": "boss_lon_loi_dam.phases[1].telegraph_time_mult", "from": 1.25, "to": 1.15, "reason": "Giữ báo hiệu dài hơn pha 1 mà không thành chờ đợi"}
    ]
