  "dialogue": [
    {
      "id": "dlg_01_opening",
      "speaker": "npc_ba_lai_do",
      "trigger": "opening",
      "label": "SÁNG TẠO",
      "text": {
        "vi": "Bến này giữ bằng tay người, con ạ.",
        "en": "This landing is kept by human hands, child."
      },
      "era": "era_lac_long_quan"
    },
    {
      "id": "dlg_02_see_shard",
      "speaker": "chr_coi",
      "trigger": "boss_phase2_enter",
      "label": "SÁNG TẠO",
      "text": {
        "vi": "Ai trói mày thế này?",
        "en": "Who bound you like this?"
      },
      "era": "era_lac_long_quan"
    },
    {
      "id": "dlg_03_melting",
      "speaker": "npc_tho_duc_lang",
      "trigger": "craft_rcp_nanh_dam",
      "label": "SÁNG TẠO",
      "text": {
        "vi": "Đồng đúc sai thì đúc lại, thành lưỡi cày cho ruộng.",
        "en": "Metal cast wrong gets cast again, into a ploughshare for the fields."
      },
      "era": "era_lac_long_quan"
    },
    {
      "id": "dlg_04_ve_after_pry",
      "speaker": "narration_ve",
      "trigger": "after_pry_silence",
      "label": "SÁNG TẠO",
      "form": "luc_bat",
      "text": {
        "vi": "Ai đem khoen trói thú rừng\nThú đau hóa dữ, bến chừng chẳng êm\nSào nhà cạy mảnh đêm đêm\nTay người giữ bến, chẳng thèm khoen ai",
        "en": "Who bound the wild beast with a khoen?\nIn pain it turned fierce, and the landing knew no peace.\nNight after night, the family pole pries the pieces free;\nhuman hands keep the landing, wanting no one's khoen."
      },
      "era": "era_lac_long_quan",
      "allowed_eras": [
        "era_lac_long_quan",
        "era_hung_vuong_18"
      ],
      "review_note": "Cần người viết vè người thật đọc lại."
    },
    {
      "id": "dlg_05_handoff",
      "speaker": "npc_nguoi_gia_ben",
      "trigger": "handoff",
      "label": "SÁNG TẠO",
      "text": {
        "vi": "Nhiều đời trước có người giữ bến này. Giờ đến lượt con.",
        "en": "Many generations ago, someone kept this landing. Now it is your turn."
      },
      "era": "era_hung_vuong_6"
    },
    {
      "id": "dlg_06_ve_floor",
      "speaker": "narration_ve",
      "trigger": "handoff_end",
      "era": "era_hung_vuong_6",
      "label": "SÁNG TẠO",
      "form": "luc_bat",
      "review_note": "Vè bản sàn (SB11-01). Cần người viết vè người thật đọc lại.",
      "text": {
        "vi": "Bến này ai giữ đêm ngày\nSào tre một cán, đôi tay chẳng rời\nNhiều đời nối bước không lơi\nTay người giữ bến, người ơi nhớ lời",
        "en": "Who keeps this landing night and day?\nOne bamboo pole, two hands that never let go.\nGeneration after generation, the steps never slacken;\nhuman hands keep the landing — remember this, friend."
      }
    },
    {
      "id": "dlg_07_theme_short",
      "speaker": "chr_buong",
      "trigger": "demo_end",
      "era": "era_hung_vuong_6",
      "label": "SÁNG TẠO",
      "text": {
        "vi": "Giữ bến bằng tay mình.",
        "en": "Keep the landing with your own hands."
      }
    }
  ]
}
