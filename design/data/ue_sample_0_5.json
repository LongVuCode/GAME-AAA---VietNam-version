  "strings": {
    "objective_start": {
      "vi": "Hỏi Năn ở bến về dấu Nghệ.",
      "en": "Ask Năn at the landing about Nghệ."
    },
    "objective_route": {
      "vi": "Tới gò nhìn: tìm cây sung chẻ ba bên bờ đê.",
      "en": "Reach the lookout: find the three-trunk fig by the bank."
    },
    "objective_help": {
      "vi": "Qua đường bờ cao hoặc bãi thấp, giúp người gánh lau.",
      "en": "Take the upper bank or marsh path and help the reed carrier."
    },
    "objective_bridge": {
      "vi": "Hạ cầu ván phía bờ đê để mở đường về.",
      "en": "Lower the plank bridge beside the bank to open the way back."
    },
    "objective_return": {
      "vi": "Qua cầu vừa mở, trở về nói chuyện với Năn.",
      "en": "Cross the opened bridge and return to Năn."
    },
    "objective_complete": {
      "vi": "Hết vòng mẫu: bạn đã giúp người và mở đường về bến.",
      "en": "Sample complete: you helped the carrier and opened the route home."
    },
    "hint_nan": {
      "vi": "E / F — nói chuyện với Năn",
      "en": "E / F — talk to Năn"
    },
    "hint_help": {
      "vi": "E / F — giúp người gánh lau thoát khỏi ván đổ",
      "en": "E / F — free the reed carrier from the fallen planks"
    },
    "hint_bridge": {
      "vi": "E / F — hạ cầu ván",
      "en": "E / F — lower the plank bridge"
    },
    "talk_nan": {
      "vi": "Năn: Nghệ đã đi về phía cây sung chẻ ba. Có người gánh lau chưa về; nếu gặp, chị giúp họ nhé.",
      "en": "Năn: Nghệ went toward the three-trunk fig. A reed carrier is still missing; please help if you find them."
    },
    "help_done": {
      "vi": "Người gánh lau: Cảm ơn cô. Nghệ đã quay lại giúp tôi rồi chạy dọc bờ đê. Cầu bên kia còn vướng dây; cô có thể hạ từ đây.",
      "en": "Reed carrier: Thank you. Nghệ came back to help me, then ran along the bank. You can lower the bridge from this side."
    },
    "bridge_done": {
      "vi": "Cầu đã hạ. Một đường về bến đã mở — không cần vòng qua bãi thấp nữa.",
      "en": "The bridge is down. A route home is open; no need to circle through the marsh again."
    },
    "return_done": {
      "vi": "Năn: Người gánh lau đã an toàn rồi. Cảm ơn chị. Hướng Nghệ đi giờ đã rõ hơn. — HẾT MẪU BỐ CỤC / TƯƠNG TÁC —",
      "en": "Năn: The carrier is safe. Thank you. Now we know more about Nghệ’s route. — END OF LAYOUT / INTERACTION SAMPLE —"
    },
    "blocked_bridge": {
      "vi": "Còn người mắc kẹt ở bờ đê. Hãy giúp họ trước khi hạ cầu.",
      "en": "Someone is still trapped by the bank. Help them before lowering the bridge."
    },
    "save_failed": {
      "vi": "Không lưu được tiến trình. Bạn vẫn có thể chơi tiếp, nhưng cần kiểm tra log trước khi thoát.",
      "en": "Progress could not be saved. You can keep playing, but check the log before quitting."
    },
    "lookout_label": {
      "vi": "Gò nhìn — sung chẻ ba",
      "en": "Lookout — three-trunk fig"
    },
    "upper_label": {
      "vi": "Bờ cao — quan sát rồi chọn đường",
      "en": "Upper bank — observe and choose"
    },
    "lower_label": {
      "vi": "Bãi thấp — tránh ổ hoặc đối đầu",
      "en": "Marsh path — avoid the nest or confront it"
    },
    "help_label": {
      "vi": "Có người mắc ở bờ đê",
      "en": "Someone is trapped beside the bank"
    },
    "bridge_label": {
      "vi": "Cầu ván về Bến Sậy",
      "en": "Plank bridge to Sậy Landing"
    },
    "start_label": {
      "vi": "BẾN SẬY",
      "en": "SẬY LANDING"
    },
    "controls": {
      "vi": "WASD đi • Chuột nhìn • E/F tương tác • Space né • Chuột trái/phải đánh • Q đỡ • Tab khóa",
      "en": "WASD move • Mouse look • E/F interact • Space dodge • LMB/RMB attack • Q parry • Tab lock"
    },
    "journal_toggle_hint": {
      "vi": "J — Nhật ký / đọc lại chỉ dẫn",
      "en": "J — Journal / reread guidance"
    },
    "journal_title": {
      "vi": "NHẬT KÝ CỦA CÓI — J để đóng",
      "en": "CÓI’S JOURNAL — J to close"
    },
    "journal_start": {
      "vi": "Cói đang tìm Nghệ. Trước tiên hãy hỏi Năn cạnh mái nghỉ ở Bến Sậy. Tới gần người đội nón ở bến, khi hiện lời nhắc thì bấm E hoặc F.",
      "en": "Cói is looking for Nghệ. First ask Năn beside the shelter at Sậy Landing. Approach the person wearing a hat and press E or F when prompted."
    },
    "journal_route": {
      "vi": "Năn nói Nghệ đã đi về phía cây sung chẻ ba. Rời bến theo dải đất tới cây có ba thân. Chưa cần tìm vật phẩm hay đánh hết quái để tiếp tục.",
      "en": "Năn said Nghệ went toward the three-trunk fig. Follow the strip of land from the landing to that tree. You do not need to collect items or defeat every enemy."
    },
    "journal_help": {
      "vi": "Từ gò cây sung có hai đường vòng qua mặt nước: bờ cao để quan sát hoặc đường thấp có ổ quái. Chỉ cần chọn một đường, không đi thẳng xuống nước. Tìm người gánh lau bị ván đổ giữ ở bờ đê phía bên kia; tới gần và bấm E hoặc F để giúp.",
      "en": "From the fig lookout, two paths circle the water: the upper bank for observation or the lower path near a creature nest. Choose either; do not cross the water directly. Find the carrier trapped by fallen planks on the far bank and press E or F to help."
    },
    "journal_bridge": {
      "vi": "Người gánh lau đã an toàn. Tới cọc kéo cạnh cầu ván đang dựng đứng ở mép bờ đê, bấm E hoặc F để hạ cầu. Việc này mở một lối đi thật về bến; không cần nhặt thêm chìa khóa.",
      "en": "The carrier is safe. Approach the pulling post beside the upright plank bridge and press E or F to lower it. This opens a physical route home; no additional key is needed."
    },
    "journal_return": {
      "vi": "Cầu đã mở. Qua cầu tới gò cây sung, đi tiếp về bến ban đầu rồi nói chuyện với Năn bằng E hoặc F. Bạn có thể trở lại bằng đường cũ nếu muốn; tiến trình không bị mất.",
      "en": "The bridge is open. Cross to the fig lookout, continue to the starting landing, and talk to Năn with E or F. You may also take an old route; progress is retained."
    },
    "journal_complete": {
      "vi": "Bạn đã giúp người, mở lối tắt và trở về Năn. Đây là điểm kết của lượt mẫu bố cục/tương tác đầu tiên; phần tiếp theo của vùng chưa có trong bản này. Có thể đi xem đường còn lại.",
      "en": "You helped the carrier, opened the shortcut and returned to Năn. This is the end of the first layout/interaction sample; the rest of the region is not included yet. You can explore the other route."
    },
    "nan_label": {
      "vi": "Năn — E/F nói chuyện",
      "en": "Năn — E/F to talk"
    }
  },
